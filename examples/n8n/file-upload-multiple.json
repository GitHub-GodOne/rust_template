            },
            {
              "id": "3997003a-ecda-43d8-98b9-6bcdf6fb9cd5",
              "name": "bearer_token",
              "value": "eyJ0_REPLACE_WITH_YOUR_API_KEY",
              "type": "string"
            },
            {
              "id": "f65c1a47-da68-491e-8da4-6d3040feecf0",
              "name": "storage_bucket_id",
              "value": "={{ $json.body?.storage_bucket_id || '' }}",
              "type": "string"
            },
            {
              "id": "6e61efed-e082-452d-851d-46b0ffb537fa",
              "name": "prefix",
              "value": "={{ $json.body?.prefix || 'n8n/multiple' }}",
              "type": "string"
            },
            {
              "id": "333a0e48-4bcf-4548-9d2f-e14d836b045b",
              "name": "visibility",
              "value": "={{ $json.body?.visibility || 'private' }}",
